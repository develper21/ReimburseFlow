# Expenseura Environment Variables
# Copy this file to .env and fill in your actual values

# Currency API (Optional)
# Leave empty to use free ExchangeRate API
# Get a key from https://exchangerate-api.com if you need higher limits
VITE_EXCHANGE_API_KEY=

# REST Countries API (Optional)
# Used for country/currency mapping
# Default value works fine for most cases
VITE_RESTCOUNTRIES_URL=https://restcountries.com/v3.1/all?fields=name,currencies

# Development Settings (Optional)
# Uncomment to enable development features
# VITE_ENABLE_DEV_TOOLS=true
# VITE_LOG_LEVEL=debug
