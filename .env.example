# ReimburseFlow Frontend - Environment Variables Template
# Copy this file to .env.local for local dev or set these variables in Netlify UI / .env.production

# Backend API Endpoint
# Local Development: http://localhost:5001/api (or leave blank to use Vite /api proxy)
# Production on Netlify: https://<your-render-service-name>.onrender.com/api
VITE_API_URL=http://localhost:5001/api

# Currency API (Optional)
# Free exchange rate endpoint or custom API key
VITE_EXCHANGE_API_KEY=https://api.exchangerate-api.com/v4/latest

# REST Countries API (Optional)
# Used for currency-country mapping
VITE_RESTCOUNTRIES_URL=https://restcountries.com/v3.1/all?fields=name,currencies
