				{
					"name": "Create Expense",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data._id) pm.collectionVariables.set('expenseId', res.data._id);",
									"pm.test('201 Created', () => pm.expect(pm.response.code).to.eql(201));",
									"pm.test('Status is pending', () => pm.expect(res.data.status).to.eql('pending'));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Client meeting lunch\",\n  \"category\": \"Meals & Entertainment\",\n  \"dateOfExpense\": \"2026-10-01\",\n  \"amount\": 1250,\n  \"currency\": \"INR\",\n  \"amountBase\": 15,\n  \"baseCurrency\": \"USD\",\n  \"exchangeRate\": 83.3,\n  \"paidBy\": \"Personal Card\",\n  \"merchant\": \"Barbeque Nation\",\n  \"department\": \"Sales\",\n  \"receiptPath\": null,\n  \"receiptName\": null,\n  \"approvalRuleId\": null\n}"
						},
						"url": "{{baseUrl}}/expenses",
						"description": "`POST /api/expenses` — submit expense (status → `pending`) + audit log. Required: `description`, `category`, `amount`. Optional: `currency` (default USD), `paidBy`, `merchant`, `department`, `receiptPath`, `approvalRuleId`.\n\n**400** if required fields missing. Saves `expenseId`."
					},
					"response": []
				},
