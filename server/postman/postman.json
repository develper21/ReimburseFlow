		{
			"name": "Auth",
			"item": [
				{
					"name": "Register (Create Company + Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);",
									"pm.test('201 Created', () => pm.expect(pm.response.code).to.eql(201));",
									"pm.test('Has token & admin role', () => {",
									"  pm.expect(res.success).to.eql(true);",
									"  pm.expect(res.user.role).to.eql('admin');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newadmin@reimburseflow.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Narvin Admin\",\n  \"companyName\": \"Acme Corp\",\n  \"country\": \"India\",\n  \"baseCurrency\": \"INR\"\n}"
						},
						"url": "{{baseUrl}}/auth/register",
						"description": "`POST /api/auth/register` — creates company + admin user in one call. Required: `email`, `password`, `fullName`, `companyName`.\n\n**400** if missing fields or email exists."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);",
									"pm.test('200 OK + token', () => {",
									"  pm.expect(pm.response.code).to.eql(200);",
									"  pm.expect(res.token).to.be.a('string');",
									"});"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": "{{baseUrl}}/auth/login",
						"description": "`POST /api/auth/login` — returns `{ token, user, company }`.\n\n**401** for wrong credentials."
					},
					"response": []
				},
				{
					"name": "Demo Login (admin | manager | employee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"admin\"\n}"
						},
						"url": "{{baseUrl}}/auth/demo-login",
						"description": "`POST /api/auth/demo-login` — `{ \"role\": \"admin\" | \"manager\" | \"employee\" }` → token for that demo user."
					},
					"response": []
