					},
					"response": []
				},
				{
					"name": "Create Expense",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.data && res.data._id) pm.collectionVariables.set('expenseId', res.data._id);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"description\": \"Client meeting lunch\",\n  \"category\": \"Meals & Entertainment\",\n  \"dateOfExpense\": \"2026-10-01\",\n  \"amount\": 1250,\n  \"currency\": \"INR\",\n  \"amountBase\": 15,\n  \"baseCurrency\": \"USD\",\n  \"exchangeRate\": 83.3,\n  \"paidBy\": \"Personal Card\",\n  \"merchant\": \"Barbeque Nation\",\n  \"department\": \"Sales\",\n  \"receiptPath\": null,\n  \"receiptName\": null,\n  \"approvalRuleId\": null\n}"
						},
						"url": "{{baseUrl}}/expenses",
						"description": "Submit an expense → status `pending`. Required: `description`, `category`, `amount`. Saves `expenseId` variable."
					},
					"response": []
				},
				{
					"name": "Delete Expense",
					"request": {
						"method": "DELETE",
						"header": [],
						"url": "{{baseUrl}}/expenses/:id",
						"description": "Delete an expense by id."
					},
					"response": []
				}
			]
		},
