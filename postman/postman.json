{
	"info": {
		"_postman_id": "b7f3a1c2-4d5e-4f6a-8b9c-0d1e2f3a4b5c",
		"name": "ReimburseFlow API — Frontend",
		"description": "Complete API collection for ReimburseFlow (Enterprise Reimbursement & Expense Intelligence Platform).\n\nThis collection mirrors the FRONTEND contract (`src/lib/api.js`) — every request the React app makes is represented here.\n\n## Environments\n- `baseUrl` — default `http://localhost:5173/api` (Vite dev proxy). Change to your deployed URL e.g. `https://<app>.netlify.app/api` if no proxy.\n\n## Auth Flow\n1. Run **Auth → Register** or **Auth → Login** (or **Demo Login**).\n2. The token is auto-saved to the collection variable `token` by the test script.\n3. All protected requests use `Authorization: Bearer {{token}}` automatically.\n\n## Conventions\nAll responses follow: `{ success, message?, count?, data }`.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{ "key": "baseUrl", "value": "http://localhost:5173/api" },
		{ "key": "token", "value": "" },
		{ "key": "email", "value": "admin@reimburseflow.com" },
		{ "key": "password", "value": "password123" }
	],
	"auth": {
		"type": "bearer",
		"bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
	},
	"item": [
		{
			"name": "Health",
			"item": [
				{
					"name": "Root Ping",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/../",
							"host": ["{{baseUrl}}"],
							"path": ["..", ""]
						},
						"description": "Service ping (no auth). Returns service name, version, status and database mode."
					},
					"response": []
				},
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/health",
						"description": "Returns `{ status: 'online', database: {...} }`."
					},
					"response": []
				}
			]
		},
		{
			"name": "Auth",
			"item": [
				{
					"name": "Register (Create Company + Admin)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);",
									"pm.test('Status 201', () => pm.expect(pm.response.code).to.eql(201));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"newadmin@reimburseflow.com\",\n  \"password\": \"password123\",\n  \"fullName\": \"Narvin Admin\",\n  \"companyName\": \"Acme Corp\",\n  \"country\": \"India\",\n  \"baseCurrency\": \"INR\"\n}"
						},
						"url": "{{baseUrl}}/auth/register",
						"description": "Creates a **company** + **admin user**, returns `{ token, user, company }`. No auth required."
					},
					"response": []
				},
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);",
									"pm.test('Status 200', () => pm.expect(pm.response.code).to.eql(200));"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": "{{baseUrl}}/auth/login",
						"description": "Email + password login. Returns `{ token, user, company }`."
					},
					"response": []
				},
				{
					"name": "Demo Login (admin | manager | employee)",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"const res = pm.response.json();",
									"if (res.token) pm.collectionVariables.set('token', res.token);"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [{ "key": "Content-Type", "value": "application/json" }],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"role\": \"admin\"\n}"
						},
						"url": "{{baseUrl}}/auth/demo-login",
						"description": "1-click demo login used by the console. Body: `{ \"role\": \"admin\" | \"manager\" | \"employee\" }`."
					},
					"response": []
				},
				{
					"name": "Get Me (Session)",
					"request": {
						"method": "GET",
						"header": [],
						"url": "{{baseUrl}}/auth/me",
						"description": "Returns current `{ user, company }` from Bearer token. Used on app boot to verify session."
					},
					"response": []
				}
			]
		},
		{
